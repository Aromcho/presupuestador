# Base de datos (docker compose levanta Postgres en el puerto 5434)
DATABASE_URL="postgresql://gesetec:gesetec@localhost:5434/gesetec"

# Servidor
PORT=4000
# Interfaz donde escucha la API (en producción detrás de Nginx: 127.0.0.1)
# HOST=127.0.0.1
NODE_ENV=development
# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000
# URL pública del panel (links de WhatsApp y PDF)
PUBLIC_SITE_URL=http://localhost:3000

# Sesión del panel (¡cambiar en producción!)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Usuarios iniciales (los crea el seed)
ADMIN_EMAIL=leo@gesetecalderas.com
ADMIN_PASSWORD=Gesetec2026!
ADMIN_NAME=Leo
VENTAS_EMAIL=administracion@gesetecalderas.com
VENTAS_PASSWORD=Ventas2026!
VENTAS_NAME=Administración

# Dólar: oficial Banco Nación (venta). Se consulta cada hora; si falla, queda el último valor.
DOLAR_API_URL=https://dolarapi.com/v1/dolares/oficial
DOLAR_REFRESH_MINUTES=60

# Carpeta de archivos subidos (fotos de equipos y PDFs)
UPLOADS_DIR=./uploads
